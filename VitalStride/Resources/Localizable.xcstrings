    "active_workout.substitute.error_generic" : {
      "extractionState" : "manual",
      "comment" : "Inline error shown when the AI substitute request fails (network, provider, or parse error). Precedes the \"Choose Manually\" fallback button (T012, T015). Must not contain health values or provider-internal detail (FR-007 / Bar B).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't get smart suggestions right now."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时无法获取智能推荐。"
          }
        }
      }
    },
    "active_workout.substitute.error_no_candidates" : {
      "extractionState" : "manual",
      "comment" : "Inline error shown when the AI returned no usable candidates (empty after filtering self-reference / unknown presetIds). Precedes the \"Choose Manually\" fallback button (T012, T015, Edge Cases).",
