{
  "sourceLanguage": "en",
  "strings": {
    "active_workout.heart_rate.disconnected": {
      "extractionState": "manual",
      "comment": "Active workout HR compact display when no Apple Watch is connected / reachable (MY-1283 three-state HR).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Watch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未连接"
          }
        }
      }
    },
    "active_workout.heart_rate.awaiting": {
      "extractionState": "manual",
      "comment": "Active workout HR compact display when Watch is connected but no HR sample has arrived yet (MY-1283 three-state HR).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "…"
          }
        }
      }
    },
    "active_workout.heart_rate.disconnected_a11y": {
      "extractionState": "manual",
      "comment": "VoiceOver value for the active-workout heart-rate metric when no Apple Watch is connected (MY-1283).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch not connected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需 Apple Watch 连接"
          }
        }
      }
    },
    "active_workout.heart_rate.awaiting_a11y": {
      "extractionState": "manual",
      "comment": "VoiceOver value for the active-workout heart-rate metric when connected to Watch but waiting for the first sample (MY-1283).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for heart rate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待心率数据"
          }
        }
      }
    },
    "active_workout_toggle_large_text_size": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to large text size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换大字号"
          }
        }
      }
    },
    "active_workout_toggle_normal_text_size": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to normal text size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换普通字号"
          }
        }
      }
    },
    "active_workout.previous_set_hint_format": {
      "extractionState": "manual",
      "comment": "Previous-set hint shown on each SetRow during an active workout. %1$@ is a preformatted weight string that already includes the unit (e.g. \"60 kg\"); %2$lld is the reps count.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous %1$@ x %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次 %1$@ × %2$lld"
          }
        }
      }
    },
    "active_workout.substitute.menu_title": {
      "extractionState": "manual",
      "comment": "Menu / context-menu entry that opens the AI-powered substitute-exercise sheet (T011). Sits above the existing \"Replace Exercise\" full-picker entry.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Substitute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能替代"
          }
        }
      }
    },
    "active_workout.substitute.sheet_title": {
      "extractionState": "manual",
      "comment": "Navigation title of the AI substitute-exercise sheet (T012).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Smart Substitute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能替代"
          }
        }
      }
    },
    "active_workout.substitute.loading": {
      "extractionState": "manual",
      "comment": "Loading state text shown in the substitute-exercise sheet while the AI request is in flight (T012).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding alternatives…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在寻找替代动作…"
          }
        }
      }
    },
    "active_workout.substitute.error_generic": {
      "extractionState": "manual",
      "comment": "Inline error shown when the AI substitute request fails (network, provider, or parse error). Precedes the \"Choose Manually\" fallback button (T012, T015). Must not contain health values or provider-internal detail (FR-007 / Bar B).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get smart suggestions right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法获取智能推荐。"
          }
        }
      }
    },
    "active_workout.substitute.error_no_candidates": {
      "extractionState": "manual",
      "comment": "Inline error shown when the AI returned no usable candidates (empty after filtering self-reference / unknown presetIds). Precedes the \"Choose Manually\" fallback button (T012, T015, Edge Cases).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching alternatives found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到匹配的替代动作。"
          }
        }
      }
    },
    "active_workout.substitute.manual_select": {
      "extractionState": "manual",
      "comment": "Fallback button in the substitute-exercise sheet error state; opens the full manual ExercisePickerView pre-selected to the current muscle group (T012, T015, FR-004).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Manually"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动选择"
          }
        }
      }
    },
    "active_workout.substitute.reason_label": {
      "extractionState": "manual",
      "comment": "Label prefix shown above the AI-provided reason on each substitute card (T012). The reason value itself comes from the AI response and is not localized here.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐理由"
          }
        }
      }
    },
    "active_workout.substitute.card_a11y_hint": {
      "extractionState": "manual",
      "comment": "Accessibility hint for each substitute suggestion card; tapping replaces the current exercise (T012, T014).",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to replace the current exercise with this suggestion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点两下用此推荐替换当前动作。"
          }
        }
      }
    },
    "workout_detail_hrr_1min": {
      "extractionState": "manual",
      "comment": "1-minute heart rate recovery (HRR) label in workout summary",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1-min HRR"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分钟 HRR"
          }
        }
      }
    },
    "workout_detail_hrr_1min_a11y": {
      "extractionState": "manual",
      "comment": "1-minute heart rate recovery a11y; %lld is the HRR value in bpm",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1-minute heart rate recovery %lld beats per minute"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分钟心率恢复 %lld 次每分钟"
          }
        }
      }
    },
    "workout_detail_estimated_1rm": {
      "extractionState": "manual",
      "comment": "Per-exercise estimated one-rep max label + a11y",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated 1RM"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预估 1RM"
          }
        }
      }
    },
    "workout_detail_view_1rm_trend": {
      "extractionState": "manual",
      "comment": "Navigation link from workout detail exercise section to the per-exercise 1RM trend view",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View 1RM Trend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看 1RM 趋势"
          }
        }
      }
    },
    "workout_detail_view_1rm_trend_a11y": {
      "extractionState": "manual",
      "comment": "A11y label for View 1RM Trend link",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View one rep max trend for this exercise"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看该动作的 1RM 趋势"
          }
        }
      }
    },
    "one_rep_max_trend_title": {
      "extractionState": "manual",
      "comment": "Title on per-exercise 1RM trend chart",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated 1RM Trend"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预估 1RM 趋势"
          }
        }
      }
    },
    "one_rep_max_trend_empty": {
      "extractionState": "manual",
      "comment": "Empty-state text on per-exercise 1RM trend view",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No 1RM history yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无 1RM 记录"
          }
        }
      }
    },
    "one_rep_max_trend_empty_hint": {
      "extractionState": "manual",
      "comment": "Empty-state hint on per-exercise 1RM trend view",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log working sets (1–12 reps) to see this exercise's estimated 1RM trend."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录正式组（1–12 次）后，可查看该动作的预估 1RM 趋势。"
          }
        }
      }
    },
    "one_rep_max_trend_caveat": {
      "extractionState": "manual",
      "comment": "Caveat about Epley 1RM estimation accuracy (3-10 reps most accurate, >15 reps deviates)",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates are most accurate for 3–10 reps; sets with >15 reps can deviate significantly (Epley formula)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3–10 次 时估算最准确；>15 次 的组偏差较大（Epley 公式）。"
          }
        }
      }
    },
    "one_rep_max_trend_single_point_hint": {
      "extractionState": "manual",
      "comment": "Hint shown when only a single 1RM data point exists",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one session available — log more to see a trend line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有一次记录 — 多记录几次可看到趋势线。"
          }
        }
      }
    },
    "one_rep_max_trend_point_count %lld": {
      "extractionState": "manual",
      "comment": "Number of sessions on trend chart, e.g. \"7 sessions\"",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sessions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 次"
          }
        }
      }
    },
    "one_rep_max_trend_a11y %lld %@ %@ %@": {
      "extractionState": "manual",
      "comment": "1RM trend chart a11y label: sessions count, first value, last value, unit",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimated 1RM trend with %1$lld sessions, from %2$@ to %3$@ %4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预估 1RM 趋势，%1$lld 次记录，从 %2$@ 到 %3$@ %4$@"
          }
        }
      }
    },
