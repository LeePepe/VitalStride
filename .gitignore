# Redesign dev-only prototype scaffolding — SPM package source is tracked
# (see specs/017-workout-keyboard-redesign — the Prototype target holds the
# frozen visual reference for the workout keyboard). Build artifacts stay
# ignored via the top-level .build/ + Packages/*/.build/ rules.
Prototype/.build/
Prototype/.swiftpm/
Prototype/*.xcodeproj/

# Local dev-only scripts (personal device names / UDIDs — not shipped)
local/

# fastlane build artifacts + App Store Connect API key (never commit the .p8)
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
AuthKey_*.p8
*.ipa
*.dSYM.zip


# fastlane sigh-downloaded provisioning profiles (never commit — signing material)
*.mobileprovision
AppStore_*.mobileprovision

# ruflo (agent meta-harness) — local runtime state, vector DB, session data.
# .claude/ 是个人 harness 配置（ruflo 装的 skills/commands/agents 约 2.1M），
# 不随 repo 走；换机器重跑 `ruflo init`。
.claude/
.claude-flow/
.swarm/
ruvector.db
