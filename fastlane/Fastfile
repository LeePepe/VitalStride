# VitalStride TestFlight 自动发布 lane。
#
# 由 .github/workflows/testflight.yml 在 self-hosted runner 上调用。
# 全程走 App Store Connect API Key（.p8），无需 Apple ID / 2FA。
#
# 需要的环境变量（workflow 从 GitHub Secrets 注入）：
#   ASC_KEY_ID          — App Store Connect API Key 的 Key ID
#   ASC_ISSUER_ID       — Issuer ID
#   ASC_KEY_P8_BASE64   — AuthKey_XXX.p8 文件内容的 base64（避免多行 Secret 问题）
#
# 签名：project.yml 保持 Automatic + DEVELOPMENT_TEAM(4Z8GG667QD)。
# archive 用 -allowProvisioningUpdates，让 xcodebuild 用 API key 非交互地
# 创建/下载 app + widget 扩展的 distribution profile。Distribution 证书复用
# runner 登录钥匙串里已有的那张。

default_platform(:ios)

APP_IDENTIFIER = "com.vitalstride.ios".freeze
SCHEME = "VitalStride".freeze
XCODEPROJ = "VitalStride.xcodeproj".freeze
# MARKETING_VERSION，与 project.yml 保持一致；改版本号时两处同步。
MARKETING_VERSION = "1.0".freeze

platform :ios do
  desc "Build and upload a build to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # project.yml 是配置真理之源（宪法 IV）；重生成 pbxproj 保证一致。
    sh("cd .. && xcodegen generate")

    # Build number = TestFlight 上现存最大值 + 1（永不撞号、不浪费号）。
    # 首次该 app 无 build 时 latest_testflight_build_number 返回 0 → next = 1。
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: MARKETING_VERSION,
      initial_build_number: 0
    )
    next_build = latest.to_i + 1
    UI.message("TestFlight latest build = #{latest}; this build = #{next_build}")

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      # 覆盖 build number 仅作用于本次 archive，不写回 project.yml。
      # -allowProvisioningUpdates 让 xcodebuild 用 API key 自动管 profile。
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} -allowProvisioningUpdates",
      export_options: {
        # 防止 gym 覆盖我们算好的 build number。
        manageAppVersionAndBuildNumber: false
      },
      output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      # 只传，不等 Apple 处理完（处理是异步的，几分钟后自动可用）。
      skip_waiting_for_build_processing: true,
      # 内部测试无需提交 App Review。
      skip_submission: true
    )
  end
end
