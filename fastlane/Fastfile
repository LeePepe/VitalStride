# VitalStride TestFlight 自动发布 lane。
#
# 由 .github/workflows/testflight.yml 在 self-hosted runner 上调用。
# 全程走 App Store Connect API Key（.p8），无需 Apple ID / 2FA。
#
# 需要的环境变量（workflow 从 GitHub Secrets 注入）：
#   ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_P8_BASE64
#
# 签名：automatic + API key + -allowProvisioningUpdates。两个 bundleID
# (app + widget) 均已在 Developer Portal 注册并带 HealthKit capability。
# 用 export_team_id + DEVELOPMENT_TEAM 锁定付费 team，避免钥匙串里其它账号证书干扰。

# 签名：manual + App Store distribution profile（fastlane 自动为付费 team 拉取）。
# 不用 automatic —— runner 钥匙串含 5 个 Apple 账号的证书，automatic 在 archive
# 阶段给每个 target 解析 Development 证书，但付费 team 4Z8GG667QD 只有 Distribution、
# 无 Development → automatic 回退误挑别账号（qq.com 等）的 Development 证书 →
# errSecInternalComponent。改 manual：用 get_provisioning_profile 拉两个 bundleID 的
# App Store profile，build_app 显式映射，彻底不依赖 automatic 的启发式挑选。

default_platform(:ios)

APP_IDENTIFIER = "com.leepepe.vitalstride".freeze
WIDGET_IDENTIFIER = "com.leepepe.vitalstride.widgets".freeze
SCHEME = "VitalStride".freeze
XCODEPROJ = "VitalStride.xcodeproj".freeze
TEAM_ID = "4Z8GG667QD".freeze
MARKETING_VERSION = "1.1".freeze

platform :ios do
  desc "Build and upload a build to TestFlight (internal testing)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    sh("cd .. && xcodegen generate")

    # Build number 必须**全局单调递增**（跨 marketing version 不重置）。
    # 之前传 `version: MARKETING_VERSION` 会把查询限定在「当前版本内」，导致
    # bump 到 1.1 后 build 从 1 重新开始 —— 而 1.0 已经到 build 4，1.1(1) 的
    # CFBundleVersion(1) < 1.0(4)，TestFlight/ASC 按全局 build number 判新旧，
    # 于是把 1.1(1) 当成比 1.0(4) 旧的构建。去掉 version: 后查该 app 所有版本
    # 的最大 build，1.1 会从 5 起，不再倒退。
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    )
    next_build = latest.to_i + 1
    UI.message("TestFlight latest build (all versions) = #{latest}; this build = #{next_build}")

    # 为 app + widget 拉 App Store distribution profile（付费 team）。
    # 需要时自动在 Developer Portal 创建（含各自的 capability）。
    # 不传 adhoc/developer_id（互斥且默认即 false = App Store distribution）。
    app_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: TEAM_ID,
      skip_install: false
    )
    widget_profile = get_provisioning_profile(
      api_key: api_key,
      app_identifier: WIDGET_IDENTIFIER,
      team_id: TEAM_ID,
      skip_install: false
    )

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: TEAM_ID,
      # 签名走 project.yml 的 Release config：每个 target 各自 Manual +
      # PROVISIONING_PROFILE_SPECIFIER（profile 已由上面 get_provisioning_profile
      # 拉取并安装）。这里只注入 build number + team，不再全局覆盖签名设置
      # （全局 xcargs 无法按 target 区分 app/widget 的不同 profile）。
      xcargs: "CURRENT_PROJECT_VERSION=#{next_build} " \
              "DEVELOPMENT_TEAM=#{TEAM_ID}",
      export_options: {
        manageAppVersionAndBuildNumber: false,
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => ENV.fetch("sigh_#{APP_IDENTIFIER}_appstore_profile-name",
                                      app_profile),
          WIDGET_IDENTIFIER => ENV.fetch("sigh_#{WIDGET_IDENTIFIER}_appstore_profile-name",
                                         widget_profile)
        }
      },
      output_directory: ENV.fetch("RUNNER_TEMP", "/tmp"),
      clean: true
    )

    # 自动把 build 分配到 TestFlight internal 群组，省去每次手动加。
    # 群组名从 TESTFLIGHT_GROUPS 读（逗号分隔可多组），默认 ASC 每个 app 自带的
    # "App Store Connect Users" internal 群组。
    #
    # 分配群组要求 build 已 processed，所以 skip_waiting_for_build_processing 为
    # false（lane 会等 ASC 处理完，通常 5-15min；workflow timeout 40min 足够）。
    # 容错：即使等待/分配这步失败（处理异常慢、ASC 抖动），build 本身已上传成功，
    # 不让整个 lane 失败 —— 分配可下次补或手动加。
    tf_groups = ENV.fetch("TESTFLIGHT_GROUPS", "App Store Connect Users")
                   .split(",").map(&:strip).reject(&:empty?)
    begin
      upload_to_testflight(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        skip_waiting_for_build_processing: false,
        skip_submission: true,
        distribute_external: false,
        groups: tf_groups
      )
    rescue => e
      UI.error("upload_to_testflight group-distribution step failed: #{e.message}")
      UI.important("Binary upload itself may have succeeded; group assignment can be redone manually or next run.")
      raise e if ENV["TESTFLIGHT_STRICT_UPLOAD"] == "1"
    end
  end
end
