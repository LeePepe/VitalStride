#!/bin/bash
# VitalStride pre-push hook
#
# This project uses a no-PR workflow (see AGENTS.md → Git Workflow):
#   - FS pushes agent/<issue>-<task-id> branches to the LOCAL bare repo
#   - TL rebases onto github/main and pushes main to the public remote
#   - No PRs, no agent branches on github
#
# This hook runs on EVERY push (FS bare-repo push and TL github push)
# and enforces:
#
#   1. Only 'main' may be pushed to public remotes (github/gitlab)
#   2. xcodebuild test (combined build+test) for app-target changes
#   3. swift build + swift test for Packages/* only changes
#   4. Skip build for pure docs/hooks/scripts changes
#   5. SwiftLint on changed Swift files
#   6. FS agent branches must include the active MY-* issue key in every commit
#
# Performance:
#   - Shared DerivedData at <git-common-dir>/derived-data
#   - flock (or mkdir fallback) at <git-common-dir>/build.lock
#     so parallel agent worktrees serialize xcodebuild but share cache.

set -uo pipefail

REMOTE="$1"
REMOTE_URL="$2"
ZERO_SHA="0000000000000000000000000000000000000000"

PROJECT_DIR="$(git rev-parse --show-toplevel)"
cd "$PROJECT_DIR"

GIT_COMMON_DIR="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
LOCK_FILE="$GIT_COMMON_DIR/build.lock"
LOCK_DIR="$GIT_COMMON_DIR/build.lock.d"
DERIVED_DATA="$GIT_COMMON_DIR/derived-data"

TMPDIR=$(mktemp -d)
USING_MKDIR_LOCK=false

cleanup() {
  rm -rf "$TMPDIR"
  if [ "$USING_MKDIR_LOCK" = true ]; then
    rmdir "$LOCK_DIR" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# ---- 1. Detect remote type ---------------------------------------------------

IS_PUBLIC_REMOTE=false
case "$REMOTE_URL" in
  *github.com*|*gitlab.com*) IS_PUBLIC_REMOTE=true ;;
esac

# ---- 2. Parse push refs from stdin -------------------------------------------

HAS_NON_DELETE_REF=false
ALL_CHANGED="$TMPDIR/changed.txt"
touch "$ALL_CHANGED"

ISSUE_CONTEXT="$PROJECT_DIR/.agent_context/issue_context.md"
ISSUE_KEY=""
if [ -f "$ISSUE_CONTEXT" ]; then
  ISSUE_KEY=$(grep -Eo 'MY-[0-9]+' "$ISSUE_CONTEXT" | head -1 || true)
fi

check_agent_commit_issue_key() {
  local local_sha="$1"
  local remote_ref="$2"
  local remote_sha="$3"
  local merge_base="$4"

  case "$remote_ref" in
    refs/heads/agent/*) ;;
    *) return 0 ;;
  esac

  if [ ! -f "$ISSUE_CONTEXT" ]; then
    echo "⚠️  .agent_context/issue_context.md not found; skipping MY-* commit-message check."
    return 0
  fi

  if [ -z "$ISSUE_KEY" ]; then
    echo "⚠️  No MY-* issue key found in .agent_context/issue_context.md; skipping commit-message check."
    return 0
  fi

  local range_start=""
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    range_start="$merge_base"
  else
    range_start="$remote_sha"
  fi

  local commits=""
  if [ -n "$range_start" ]; then
    commits=$(git rev-list --reverse "$range_start..$local_sha" 2>/dev/null || true)
  else
    commits=$(git rev-list --reverse "$local_sha" 2>/dev/null || true)
  fi

  [ -n "$commits" ] || return 0

  local missing=0
  local commit subject body
  while IFS= read -r commit; do
    [ -n "$commit" ] || continue
    subject=$(git log -1 --format=%s "$commit")
    body=$(git log -1 --format=%b "$commit")
    if ! printf '%s\n%s\n' "$subject" "$body" | grep -Fq "$ISSUE_KEY"; then
      if [ "$missing" -eq 0 ]; then
        echo "❌ BLOCKED: commits pushed to $remote_ref must mention $ISSUE_KEY"
        echo ""
        echo "  Add the issue key to each commit subject or body."
        echo "  Examples:"
        echo "    git commit -m \"feat: ExercisePickerView 多选批量添加 ($ISSUE_KEY)\""
        echo "    git commit -m \"feat: 多选 picker\" -m \"Implements $ISSUE_KEY.\""
        echo ""
        echo "  Missing $ISSUE_KEY:"
      fi
      printf '    - %s %s\n' "$(git rev-parse --short "$commit")" "$subject"
      missing=1
    fi
  done <<< "$commits"

  if [ "$missing" -ne 0 ]; then
    exit 1
  fi
}

# Find a github remote name for diff base fallback
GH_REMOTE=$(git remote -v 2>/dev/null \
  | awk '/github\.com.*\(push\)/ {print $1; exit}' || true)
GH_REMOTE="${GH_REMOTE:-origin}"

while read -r local_ref local_sha remote_ref remote_sha; do
  # Branch deletion
  if [ "$local_sha" = "$ZERO_SHA" ]; then
    continue
  fi
  HAS_NON_DELETE_REF=true

  # GUARD: only 'main' may go to github/gitlab
  if [ "$IS_PUBLIC_REMOTE" = true ] && [ "$local_ref" != "refs/heads/main" ]; then
    echo "❌ BLOCKED: only 'main' may be pushed to public remote ($REMOTE_URL)"
    echo ""
    echo "  Attempted: $local_ref"
    echo ""
    echo "  This project uses no-PR workflow:"
    echo "    FS  → push agent/<issue>-<task-id> to LOCAL bare repo"
    echo "    TL  → rebase onto github/main, push main to public remote"
    echo "  See AGENTS.md → Git Workflow"
    exit 1
  fi

  # Determine merge base for the changed-files diff (MY-876).
  # For new agent branches (remote_sha is ZERO_SHA) we must compare against
  # a true fork point so every commit on the branch is classified — never
  # against a fixed depth like $local_sha~N, which silently drops older
  # commits and lets unrelated app/package changes bypass the build/lint
  # gate. Order: real GitHub remote first → any fetched remote-tracking
  # main → repo root commit. If none exists, leave merge_base empty.
  if [ "$remote_sha" = "$ZERO_SHA" ]; then
    merge_base=""
    if [ -n "$GH_REMOTE" ] && git rev-parse --verify -q "$GH_REMOTE/main^{commit}" >/dev/null 2>&1; then
      merge_base=$(git merge-base "$GH_REMOTE/main" "$local_sha" 2>/dev/null || echo "")
    fi
    if [ -z "$merge_base" ]; then
      # Fallback: any remote-tracking main we have locally (origin/main,
      # local-bare/main, etc.). Avoids depth heuristics.
      for ref in $(git for-each-ref --format='%(refname)' 'refs/remotes/*/main' 2>/dev/null); do
        candidate=$(git merge-base "$ref" "$local_sha" 2>/dev/null || true)
        if [ -n "$candidate" ]; then
          merge_base="$candidate"
          break
        fi
      done
    fi
    if [ -z "$merge_base" ]; then
      # Final fallback: repository root commit. Classifies every commit
      # on this branch instead of silently skipping older history.
      merge_base=$(git rev-list --max-parents=0 "$local_sha" 2>/dev/null | tail -1)
    fi
  else
    merge_base="$remote_sha"
  fi

  check_agent_commit_issue_key "$local_sha" "$remote_ref" "$remote_sha" "$merge_base"

  if [ -n "$merge_base" ]; then
    git diff --name-only --diff-filter=ACMR \
      "$merge_base"..."$local_sha" 2>/dev/null >> "$ALL_CHANGED" || true
  fi
done

if [ "$HAS_NON_DELETE_REF" = false ]; then
  echo "Deleting remote ref, skipping checks."
  exit 0
fi

CHANGED=$(sort -u "$ALL_CHANGED" | grep -v '^$' || true)

if [ -z "$CHANGED" ]; then
  echo "ℹ️  No file changes detected, skipping checks."
  exit 0
fi

# ---- 3. Classify changes -----------------------------------------------------

# Pure-docs pattern: nothing affects the build
DOC_PATTERN='^(docs/|[^/]*\.md$|scripts/hooks/|scripts/setup-hooks\.sh$|\.gitignore$|LICENSE$|\.github/)'

NON_DOC=$(echo "$CHANGED" | grep -vE "$DOC_PATTERN" || true)
if [ -z "$NON_DOC" ]; then
  echo "📝 Pure docs/hooks/scripts changes — skipping build."
  exit 0
fi

# Packages touched (per-package list)
PACKAGES_TOUCHED=$(echo "$CHANGED" \
  | grep -E '^Packages/[^/]+/' \
  | sed -E 's|^Packages/([^/]+)/.*|\1|' \
  | sort -u || true)

# Anything outside Packages/ that isn't a doc — forces full xcodebuild
NON_PACKAGE=$(echo "$NON_DOC" | grep -vE '^Packages/' || true)

# ---- 4. Build / test ---------------------------------------------------------

if [ -z "$NON_PACKAGE" ] && [ -n "$PACKAGES_TOUCHED" ]; then
  # SPM-only path: swift build + swift test for each touched package
  echo "📦 Package-only changes detected:"
  while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    echo "    - $pkg"
  done <<< "$PACKAGES_TOUCHED"
  echo ""

  while IFS= read -r pkg; do
    [ -z "$pkg" ] && continue
    [ -d "Packages/$pkg" ] || continue

    echo "🔨 swift build [$pkg]"
    LOG=$(mktemp)
    if (cd "Packages/$pkg" && swift build 2>&1) > "$LOG"; then
      :
    else
      tail -30 "$LOG"
      rm -f "$LOG"
      echo "❌ swift build failed for Packages/$pkg"
      exit 1
    fi
    rm -f "$LOG"

    echo "🧪 swift test  [$pkg]"
    LOG=$(mktemp)
    if (cd "Packages/$pkg" && swift test 2>&1) > "$LOG"; then
      :
    else
      tail -30 "$LOG"
      rm -f "$LOG"
      echo "❌ swift test failed for Packages/$pkg"
      exit 1
    fi
    rm -f "$LOG"
  done <<< "$PACKAGES_TOUCHED"

  echo "✅ Package builds + tests passed."

else
  # App-target path: full xcodebuild test (combined build+test)
  mkdir -p "$DERIVED_DATA"
  echo "🔨 Pre-push: xcodebuild test"
  echo "   DerivedData: $DERIVED_DATA"
  echo "   Lock:        $LOCK_FILE"
  echo ""

  TEST_LOG=$(mktemp)

  run_xcodebuild_test() {
    set -o pipefail
    xcodebuild test \
      -project VitalStride.xcodeproj \
      -scheme VitalStride \
      -destination 'platform=iOS Simulator,name=iPhone 17 Pro,OS=latest' \
      -configuration Debug \
      -derivedDataPath "$DERIVED_DATA" \
      -skipPackagePluginValidation \
      2>&1 | tee "$TEST_LOG" | tail -10
  }

  if command -v flock >/dev/null 2>&1; then
    ( flock -w 1800 9 || { echo "❌ build lock timeout (30min)"; exit 1; }
      run_xcodebuild_test
    ) 9>"$LOCK_FILE"
    build_exit=$?
  else
    # mkdir-based fallback (macOS doesn't ship flock)
    # Stale-lock cleanup: remove dirs older than 1h
    if [ -d "$LOCK_DIR" ]; then
      lock_age=$(( $(date +%s) - $(stat -f %m "$LOCK_DIR" 2>/dev/null || echo 0) ))
      if [ "$lock_age" -gt 3600 ]; then
        echo "⚠️  Removing stale lock dir (>1h old)"
        rmdir "$LOCK_DIR" 2>/dev/null || true
      fi
    fi
    USING_MKDIR_LOCK=true
    RETRIES=180
    while ! mkdir "$LOCK_DIR" 2>/dev/null; do
      RETRIES=$((RETRIES - 1))
      if [ $RETRIES -le 0 ]; then
        echo "❌ build lock timeout (30min)"
        rm -f "$TEST_LOG"
        exit 1
      fi
      sleep 10
    done
    run_xcodebuild_test
    build_exit=$?
    rmdir "$LOCK_DIR" 2>/dev/null || true
    USING_MKDIR_LOCK=false
  fi

  if [ "$build_exit" -ne 0 ]; then
    echo ""
    echo "❌ xcodebuild test failed (exit $build_exit). Push aborted."
    echo "Last 30 lines of build log:"
    tail -30 "$TEST_LOG"
    rm -f "$TEST_LOG"
    exit "$build_exit"
  fi

  rm -f "$TEST_LOG"
  echo "✅ xcodebuild test passed."
fi

# ---- 5. SwiftLint changed Swift files ---------------------------------------
#
# Strict mode is enforced ONLY on lines actually touched by the push.
# Pre-existing violations on lines this push didn't modify are reported as
# warnings (printed once, non-fatal) so legacy debt doesn't block legitimate
# work, but we never add new violations to touched lines.

SWIFT_FILES=$(echo "$CHANGED" | grep '\.swift$' || true)

if [ -n "$SWIFT_FILES" ] && command -v swiftlint >/dev/null 2>&1; then
  echo ""
  echo "🔍 SwiftLint (touched lines only — strict; rest reported as warnings)..."
  LINT_FAIL=0
  LEGACY_COUNT=0
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    [ -f "$file" ] || continue

    # Compute the set of line numbers changed by this push for this file.
    # Use the same merge_base..local_sha range the SWIFT_FILES list came from.
    # Parse `@@ -... +<start>[,<count>] @@` hunk headers from `git diff -U0`.
    # Uses POSIX awk (no gawk-only `match(..., arr)` since macOS ships BSD awk).
    touched_lines=$(
      git diff -U0 --diff-filter=ACMR "$merge_base"..."$local_sha" -- "$file" 2>/dev/null \
        | awk '
            /^@@/ {
              # Extract the +<start>[,<count>] token
              for (i = 1; i <= NF; i++) {
                if ($i ~ /^\+[0-9]+/) {
                  tok = substr($i, 2)              # drop leading "+"
                  split(tok, parts, ",")
                  start = parts[1] + 0
                  count = (parts[2] == "" ? 1 : parts[2] + 0)
                  for (j = 0; j < count; j++) print start + j
                  break
                }
              }
            }' \
        | sort -un
    )

    # Run swiftlint --strict on the file. Capture output.
    lint_out=$(swiftlint lint --quiet --strict -- "$file" 2>&1) || true
    [ -z "$lint_out" ] && continue

    new_violations=""
    legacy_violations=""
    while IFS= read -r line; do
      [ -z "$line" ] && continue
      # SwiftLint output: <path>:<line>:<col>: <severity>: <rule>
      violation_line=$(echo "$line" | awk -F: '{print $2}')
      if [ -z "$violation_line" ] || ! [[ "$violation_line" =~ ^[0-9]+$ ]]; then
        continue
      fi
      if echo "$touched_lines" | grep -qx "$violation_line"; then
        new_violations="${new_violations}${line}"$'\n'
      else
        legacy_violations="${legacy_violations}${line}"$'\n'
      fi
    done <<< "$lint_out"

    if [ -n "$new_violations" ]; then
      echo "❌ NEW SwiftLint violations on lines touched by this push ($file):"
      echo "$new_violations" | sed '/^$/d' | sed 's/^/   /'
      LINT_FAIL=1
    fi
    if [ -n "$legacy_violations" ]; then
      legacy_count=$(echo "$legacy_violations" | sed '/^$/d' | wc -l | tr -d ' ')
      LEGACY_COUNT=$((LEGACY_COUNT + legacy_count))
    fi
  done <<< "$SWIFT_FILES"

  if [ "$LINT_FAIL" -ne 0 ]; then
    echo ""
    echo "❌ SwiftLint errors on lines you modified. Push aborted."
    exit 1
  fi

  if [ "$LEGACY_COUNT" -gt 0 ]; then
    echo "⚠️  $LEGACY_COUNT pre-existing SwiftLint violation(s) on untouched lines — not blocking."
  fi
  echo "✅ SwiftLint passed for touched lines."
fi

# ---- 6. Optional i18n parity report ----------------------------------------

if [ -f "scripts/i18n_check_lproj_parity.py" ] && command -v python3 >/dev/null 2>&1; then
  echo ""
  echo "🌐 i18n parity baseline (non-blocking)..."
  I18N_LOG=$(mktemp)
  if python3 scripts/i18n_check_lproj_parity.py > "$I18N_LOG" 2>&1; then
    cat "$I18N_LOG"
    coverage=$(awk -F': ' '/^en_coverage_pct:/ {print $2}' "$I18N_LOG" | tail -1)
    if [ -n "$coverage" ]; then
      awk -v pct="$coverage" 'BEGIN { exit (pct < 50.0 ? 0 : 1) }'
      if [ "$?" -eq 0 ]; then
        echo "⚠️  en localization coverage is below 50% (${coverage}%) — warning only."
      fi
    fi
  else
    echo "⚠️  i18n parity check failed — warning only."
    tail -20 "$I18N_LOG"
  fi
  rm -f "$I18N_LOG"
fi

# ---- 7. Layer frontmatter anti-rot check -----------------------------------
# 校验 Packages/*/CONTEXT.md frontmatter 与代码一致（layer 名 / depends_on 双向 /
# test 路径 / roles ∈ canonical_roles 且目录存在）。腐烂即阻塞。

if [ -f "scripts/check-frontmatter.sh" ]; then
  echo ""
  echo "🧭 Layer frontmatter 防腐校验..."
  if ! bash scripts/check-frontmatter.sh; then
    echo "❌ frontmatter 与代码不一致。更新对应 CONTEXT.md 后重推。Push aborted."
    exit 1
  fi
fi

echo ""
echo "✅ All pre-push checks passed."
