#!/bin/bash
# VitalStride pre-commit hook
#
# 1. Block direct commits to main / master
# 2. SwiftLint staged Swift files (fast — no build)
# 3. Incremental per-layer discovery: build/test each touched production SPM
#    layer and build the isolated Prototype layer. AppUI/RepoInfra/support
#    paths skip heavy build; RepoInfra's focused gate runs at pre-push + CI.
#
# Required CI runs full AppUI xcodebuild. This hook is the fast inner-loop
# subset scoped to the layers actually touched.

set -uo pipefail

REPO="$(git rev-parse --show-toplevel)"; cd "$REPO"

# ---- 1. Block direct commits to main/master ---------------------------------

branch=$(git branch --show-current)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "❌ ERROR: direct commits to '$branch' are forbidden."
  echo ""
  echo "  Use a feature branch (agent/* worktree branch), push it, and open a PR."
  echo "  main is updated only by merging a PR (branch protection blocks direct pushes)."
  exit 1
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)
[ -z "$STAGED" ] && exit 0

# ---- 2. SwiftLint staged Swift files ----------------------------------------

if command -v swiftlint >/dev/null 2>&1; then
  STAGED_SWIFT=$(echo "$STAGED" | grep -E '\.swift$' || true)
  if [ -n "$STAGED_SWIFT" ]; then
    LINT_ARGS=()
    while IFS= read -r file; do
      [ -f "$file" ] && LINT_ARGS+=("$file")
    done <<< "$STAGED_SWIFT"
    if [ ${#LINT_ARGS[@]} -gt 0 ]; then
      # Match CI behavior: use --baseline so pre-existing grandfathered
      # violations (see .swiftlint-baseline.json + .swiftlint.yml 棘轮 note)
      # do not block commits touching files that already carry them.
      BASELINE_ARGS=()
      if [ -f ".swiftlint-baseline.json" ]; then
        BASELINE_ARGS+=(--baseline .swiftlint-baseline.json)
      fi
      if ! swiftlint lint --quiet --strict "${BASELINE_ARGS[@]}" -- "${LINT_ARGS[@]}"; then
        echo "❌ SwiftLint errors in staged files. Commit aborted."
        exit 1
      fi
    fi
  fi
fi

# ---- 3. Resolve staged paths recursively ------------------------------------

RESOLVER="scripts/lib/layer_coverage.py"
[ -f "$RESOLVER" ] || { echo "❌ missing recursive layer resolver"; exit 1; }
if ! TOUCHED_LAYERS=$(printf '%s\n' "$STAGED" | python3 "$RESOLVER" layers --stdin); then
  echo "❌ staged paths do not resolve to a unique leaf layer"
  exit 1
fi
[ -z "$TOUCHED_LAYERS" ] && exit 0

# Guard: many touched layers × per-layer build+test can break the "fast" promise.
# Above the cap, build only (defer full test to pre-push).
LAYER_COUNT=$(echo "$TOUCHED_LAYERS" | sed '/^$/d' | wc -l | tr -d ' ')
MAX_TEST_LAYERS=3
RUN_TESTS=true
if [ "$LAYER_COUNT" -gt "$MAX_TEST_LAYERS" ]; then
  RUN_TESTS=false
  echo "⚠️  改动涉及 ${LAYER_COUNT} 个 layer（>${MAX_TEST_LAYERS}）：pre-commit 只 build，测试交给 pre-push。"
fi

FAIL=0
while IFS= read -r layer; do
  [ -z "$layer" ] && continue
  tier="$(python3 "$RESOLVER" field "$layer" gate_tier)" || { FAIL=1; continue; }
  [ "$tier" = "local-fast" ] || continue
  echo "🔨 layer build [$layer]"
  python3 "$RESOLVER" run "$layer" build </dev/null || { FAIL=1; continue; }
  if [ "$RUN_TESTS" = true ]; then
    echo "🧪 layer test  [$layer]"
    python3 "$RESOLVER" run "$layer" test </dev/null || FAIL=1
  fi
done < <(printf '%s\n' "$TOUCHED_LAYERS")

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "❌ Layer build/test failed. Commit aborted（勿 --no-verify；CI 照样拦）。"
  exit 1
fi

echo "✅ pre-commit: touched layer(s) build/test passed."
