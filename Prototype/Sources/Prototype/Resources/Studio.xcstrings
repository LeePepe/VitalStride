    "compact.advancedIntro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入扩展归键盘，动作管理归更多。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Input extensions belong to the keyboard; exercise management belongs to More."
          }
        }
      }
    },
    "compact.advancedBody": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单侧重量：重量字段旁切换左 / 右。\n递增、递减子组：组类型面板继续展开。\nAI 替代、排序、删除动作：当前动作菜单。\n结束、放弃训练：训练管理并二次确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unilateral weight: left / right beside the weight field.\nAscending / drop sub-sets: expand the set type panel.\nAI replacement, reorder and delete: selected exercise menu.\nFinish or discard: workout management with confirmation."
          }
        }
      }
    },
    "compact.advancedBoundary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "功能位置说明：生产已有的高级能力尚未接入此布局原型；RPE、热身 / 正式类型已可操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Placement guide: existing production advanced capabilities are not connected to this layout prototype. RPE and warm-up / working type are interactive."
          }
        }
      }
    },
